{% doc %}
  Renders the haute-parfumerie Perfumora gallery card:
  - Color-floored top arch with ambient studio light wash
  - Equal fixed-size transparent bottle showcase
  - Seam-floating accent price pill
  - Title and uppercase category · concentration subtitle
  - 30ml / 50ml interactive size toggle pills
  - Full-width accent Add to Bag button hooked to Shopify Cart

  @param {object} product - The product object to render.
{% enddoc %}

<script
  type="module"
  src="{{ 'perfumora-card.js' | asset_url }}"
  fetchpriority="low"
></script>

{% liquid
  assign raw_hex = product.metafields.perfumora.color_hex.value | default: product.metafields.perfumora.color_hex | default: product.metafields.perfumora.fragrance_color_hex.value | default: product.metafields.perfumora.fragrance_color_hex | default: product.metafields.custom.fragrance_color_hex.value | default: product.metafields.custom.fragrance_color_hex | default: product.metafields.custom.color_hex.value | default: product.metafields.custom.color_hex | default: '#b87d88'
  assign raw_hex_clean = raw_hex | downcase | strip

  case raw_hex_clean
    when '#e5aab2'
      assign card_accent = '#9a7177'
    when '#b7bb81'
      assign card_accent = '#7c7f56'
    when '#bb7528'
      assign card_accent = '#ae6d25'
    when '#323b8f'
      assign card_accent = '#323b8f'
    when '#e5e5e5'
      assign card_accent = '#7c7c7c'
    when '#4f7942'
      assign card_accent = '#4f7942'
    else
      assign card_accent = raw_hex
  endcase

  assign bottle_image = product.metafields.perfumora.flacon_image.value | default: product.metafields.perfumora.flacon_image | default: product.metafields.custom.flacon_image.value | default: product.metafields.custom.flacon_image | default: product.featured_media.preview_image | default: product.featured_image

  assign gender = product.metafields.perfumora.gender_category.value | default: product.metafields.perfumora.gender_category | default: product.metafields.custom.gender_category.value | default: product.metafields.custom.gender_category
  assign concentration = product.metafields.perfumora.concentration.value | default: product.metafields.perfumora.concentration | default: product.metafields.custom.concentration.value | default: product.metafields.custom.concentration | default: 'Eau de Parfum'

  # Choose default size: prefer 50ml if available, then 30ml, then first available
  assign selected_variant = null
  for v in product.variants
    assign v_title = v.title | downcase
    if v_title contains '50' and v.available
      assign selected_variant = v
      break
    endif
  endfor

  if selected_variant == null
    for v in product.variants
      assign v_title = v.title | downcase
      if v_title contains '30' and v.available
        assign selected_variant = v
        break
      endif
    endfor
  endif

  if selected_variant == null
    assign selected_variant = product.selected_or_first_available_variant | default: product.variants.first
  endif
%}

<perfumora-card
  class="perfumora-card"
  data-product-id="{{ product.id }}"
  data-color="{{ raw_hex }}"
  style="--card-accent: {{ card_accent }};"
>
  <div class="perfumora-card__arch">
    <div class="perfumora-card__arch-wash" aria-hidden="true"></div>
    <a
      href="{{ product.url }}"
      class="perfumora-card__bottle-stage"
      aria-label="{{ product.title | escape }}"
    >
      {% if bottle_image != blank %}
        <img
          src="{{ bottle_image | image_url: width: 600 }}"
          srcset="{{ bottle_image | image_url: width: 300 }} 300w, {{ bottle_image | image_url: width: 600 }} 600w"
          sizes="(min-width: 990px) 25vw, (min-width: 750px) 33vw, 50vw"
          alt="{{ product.title | escape }}"
          class="perfumora-card__bottle-img"
          loading="lazy"
          width="300"
          height="400"
        >
      {% else %}
        {{ 'product-1' | placeholder_svg_tag: 'perfumora-card__bottle-img perfumora-card__bottle-placeholder' }}
      {% endif %}
    </a>
  </div>

  <div class="perfumora-card__body">
    <div class="perfumora-card__price-row">
      <span class="perfumora-card__price-pill">
        {{ selected_variant.price | money_without_trailing_zeros }}
      </span>
    </div>

    <h3 class="perfumora-card__title">
      <a href="{{ product.url }}">{{ product.title }}</a>
    </h3>

    <div class="perfumora-card__subtitle">
      {% if gender != blank %}{{ gender | upcase }} · {% endif %}{{ concentration | upcase }}
    </div>

    {% if product.variants.size > 1 %}
      <div class="perfumora-card__sizes" role="radiogroup" aria-label="Size">
        {% for variant in product.variants %}
          {% assign is_active = false %}
          {% if variant.id == selected_variant.id %}
            {% assign is_active = true %}
          {% endif %}
          <button
            type="button"
            role="radio"
            class="perfumora-card__size-btn{% if is_active %} is-active{% endif %}"
            aria-checked="{% if is_active %}true{% else %}false{% endif %}"
            data-variant-id="{{ variant.id }}"
            data-price="{{ variant.price | money_without_trailing_zeros }}"
            data-available="{{ variant.available }}"
            {% unless variant.available %}disabled{% endunless %}
          >
            {{ variant.title | upcase }}
          </button>
        {% endfor %}
      </div>
    {% endif %}

    <button
      type="button"
      class="perfumora-card__add-btn"
      data-variant-id="{{ selected_variant.id }}"
      {% unless selected_variant.available %}disabled{% endunless %}
    >
      {% if selected_variant.available %}
        Add to Bag
      {% else %}
        Sold Out
      {% endif %}
    </button>
  </div>
</perfumora-card>

{% stylesheet %}
  .perfumora-card {
    position: relative;
    display: flex;
    flex-direction: column;
    border-radius: 28px;
    background-color: #eae5dc;
    border: 1px solid rgba(26, 24, 22, 0.08);
    box-shadow: 0 18px 44px -26px rgba(11, 11, 12, 0.35);
    overflow: hidden;
    height: 100%;
    box-sizing: border-box;
    transition: transform 0.35s cubic-bezier(0.16, 1, 0.3, 1), box-shadow 0.35s cubic-bezier(0.16, 1, 0.3, 1);
  }

  .perfumora-card:hover {
    transform: translateY(-4px);
    box-shadow: 0 24px 50px -20px rgba(11, 11, 12, 0.45);
  }

  .perfumora-card__arch {
    position: relative;
    width: 100%;
    height: 290px;
    background-color: var(--card-accent, #9a7177);
    display: flex;
    align-items: center;
    justify-content: center;
    overflow: hidden;
    border-top-left-radius: 27px;
    border-top-right-radius: 27px;
    transition: background-color 0.4s ease;
  }

  @media (max-width: 640px) {
    .perfumora-card__arch {
      height: 230px;
    }
  }

  .perfumora-card__arch-wash {
    position: absolute;
    inset: 0;
    pointer-events: none;
    background: radial-gradient(120% 78% at 50% 14%, rgba(255, 255, 255, 0.22), transparent 64%);
  }

  .perfumora-card__bottle-stage {
    position: relative;
    z-index: 2;
    width: 100%;
    height: 100%;
    display: flex;
    align-items: center;
    justify-content: center;
    padding: 24px 24px 28px;
    box-sizing: border-box;
    text-decoration: none;
  }

  @media (max-width: 640px) {
    .perfumora-card__bottle-stage {
      padding: 18px 18px 22px;
    }
  }

  .perfumora-card__bottle-img {
    max-width: 78%;
    max-height: 84%;
    width: auto;
    height: 100%;
    object-fit: contain;
    object-position: center bottom;
    filter: drop-shadow(0 20px 24px rgba(11, 11, 12, 0.45));
    transition: transform 0.5s cubic-bezier(0.16, 1, 0.3, 1);
    transform-origin: center bottom;
  }

  .perfumora-card:hover .perfumora-card__bottle-img {
    transform: scale(1.06);
  }

  .perfumora-card__bottle-placeholder {
    opacity: 0.25;
  }

  .perfumora-card__body {
    display: flex;
    flex-direction: column;
    flex-grow: 1;
    padding: 16px 22px 22px;
    background-color: #eae5dc;
    border-bottom-left-radius: 27px;
    border-bottom-right-radius: 27px;
    box-sizing: border-box;
  }

  @media (max-width: 640px) {
    .perfumora-card__body {
      padding: 14px 16px 18px;
    }
  }

  .perfumora-card__price-row {
    margin-top: 2px;
    margin-bottom: 12px;
    display: flex;
  }

  .perfumora-card__price-pill {
    display: inline-flex;
    align-items: center;
    justify-content: center;
    background-color: var(--card-accent, #9a7177);
    color: #ffffff;
    border-radius: 9999px;
    padding: 6px 16px;
    font-size: 0.95rem;
    font-weight: 600;
    font-variant-numeric: tabular-nums;
    letter-spacing: -0.01em;
    box-shadow: 0 10px 22px -10px rgba(11, 11, 12, 0.6);
    transition: background-color 0.25s ease;
  }

  .perfumora-card__title {
    font-family: var(--font-body--family);
    font-size: 1.125rem;
    font-weight: 600;
    line-height: 1.25;
    letter-spacing: -0.01em;
    margin: 0 0 4px;
    color: #1a1816;
  }

  .perfumora-card__title a {
    color: inherit;
    text-decoration: none;
    transition: color 0.2s ease;
  }

  .perfumora-card__title a:hover {
    color: var(--card-accent, #9a7177);
  }

  .perfumora-card__subtitle {
    font-size: 0.6875rem;
    font-weight: 500;
    letter-spacing: 0.12em;
    text-transform: uppercase;
    color: rgba(26, 24, 22, 0.6);
    margin-bottom: 18px;
  }

  .perfumora-card__sizes {
    display: flex;
    align-items: center;
    gap: 8px;
    margin-bottom: 16px;
  }

  .perfumora-card__size-btn {
    border-radius: 9999px;
    padding: 7px 18px;
    font-size: 0.75rem;
    font-weight: 500;
    text-transform: uppercase;
    letter-spacing: 0.04em;
    background: transparent;
    cursor: pointer;
    border: 1px solid rgba(26, 24, 22, 0.2);
    color: rgba(26, 24, 22, 0.65);
    transition: all 0.2s ease;
  }

  .perfumora-card__size-btn:hover:not(:disabled) {
    color: #1a1816;
    border-color: rgba(26, 24, 22, 0.45);
  }

  .perfumora-card__size-btn.is-active {
    border: 1.5px solid var(--card-accent, #9a7177);
    color: var(--card-accent, #9a7177);
    font-weight: 600;
  }

  .perfumora-card__size-btn:disabled {
    text-decoration: line-through;
    opacity: 0.4;
    cursor: not-allowed;
  }

  .perfumora-card__add-btn {
    width: 100%;
    border-radius: 9999px;
    border: none;
    background-color: var(--card-accent, #9a7177);
    color: #ffffff;
    font-family: var(--font-body--family);
    font-size: 0.75rem;
    font-weight: 600;
    letter-spacing: 0.12em;
    text-transform: uppercase;
    padding: 13px 20px;
    cursor: pointer;
    margin-top: auto;
    box-shadow: 0 4px 14px rgba(11, 11, 12, 0.15);
    transition: all 0.2s cubic-bezier(0.16, 1, 0.3, 1);
  }

  .perfumora-card__add-btn:hover:not(:disabled) {
    opacity: 0.92;
    transform: translateY(-1px);
    box-shadow: 0 6px 18px rgba(11, 11, 12, 0.22);
  }

  .perfumora-card__add-btn:active:not(:disabled) {
    transform: translateY(0);
  }

  .perfumora-card__add-btn:disabled {
    opacity: 0.45;
    cursor: not-allowed;
  }

  .perfumora-card__add-btn.is-loading {
    opacity: 0.75;
    pointer-events: none;
  }
{% endstylesheet %}

