{% comment %}
  Section contract: Perfumora Luxury Footer
  Renders the haute-parfumerie closing brandmark, in-page navigation, and fine print.
  @example
  <!-- In sections/footer-group.json: "type": "footer" -->
{% endcomment %}

<footer
  id="footer"
  class="perfumora-footer"
  {{ section.shopify_attributes }}
>
  <div class="perfumora-footer__inner">
    <div class="perfumora-footer__grid">
      <div class="perfumora-footer__brand">
        <a href="#hero" class="perfumora-footer__wordmark" aria-label="Perfumora">
          {{ section.settings.brand_name | default: 'PERFUMORA' }}
        </a>
        <div class="perfumora-footer__tagline">
          {{ section.settings.tagline | default: '<p>One sculpted vessel. Four expressions.<br>Endlessly refillable.</p>' }}
        </div>
      </div>

      <nav class="perfumora-footer__nav" aria-label="Footer">
        {% if section.settings.menu != blank and linklists[section.settings.menu].links.size > 0 %}
          {% for link in linklists[section.settings.menu].links %}
            <a href="{{ link.url }}" class="perfumora-footer__link">
              {{ link.title }}
            </a>
          {% endfor %}
        {% else %}
          <a href="#hero" class="perfumora-footer__link">The Collection</a>
          <a href="#manifesto" class="perfumora-footer__link">Manifesto</a>
          <a href="#ritual" class="perfumora-footer__link">The Ritual</a>
          <a href="#product_list_fa6P9H" class="perfumora-footer__link">Gallery</a>
          <a href="#contact" class="perfumora-footer__link">Contact</a>
        {% endif %}
      </nav>
    </div>

    <div class="perfumora-footer__bottom">
      <span class="perfumora-footer__copyright">
        &copy; {{ 'now' | date: '%Y' }} {{ section.settings.brand_name | default: 'PERFUMORA' }}
      </span>
      <span class="perfumora-footer__subtext">
        {{ section.settings.subtext | default: 'SOUND CAN BE MUTED FROM THE HEADER' }}
      </span>
    </div>
  </div>
</footer>

{% stylesheet %}
  .perfumora-footer {
    position: relative;
    width: 100%;
    min-height: 85vh;
    min-height: 85dvh;
    background-color: #0b0b0c !important;
    color: #faf8f5;
    display: flex;
    flex-direction: column;
    justify-content: center;
    box-sizing: border-box;
    padding-block: clamp(80px, 12vh, 120px) clamp(40px, 6vh, 60px);
    overflow: hidden;
  }

  .perfumora-footer__inner {
    width: 100%;
    max-width: 1200px;
    margin-inline: auto;
    padding-inline: 24px;
    box-sizing: border-box;
    display: flex;
    flex-direction: column;
    justify-content: space-between;
    flex-grow: 1;
  }

  .perfumora-footer__grid {
    display: grid;
    grid-template-columns: 1.5fr 1fr;
    gap: clamp(40px, 8vw, 100px);
    align-items: start;
    margin-bottom: clamp(60px, 10vh, 100px);
  }

  .perfumora-footer__brand {
    display: flex;
    flex-direction: column;
    gap: 18px;
  }

  .perfumora-footer__wordmark {
    font-family: var(--font-heading--family);
    font-size: clamp(2.5rem, 4.5vw, 3.5rem);
    font-weight: 700;
    line-height: 1;
    letter-spacing: -0.01em;
    text-transform: uppercase;
    color: #faf8f5;
    text-decoration: none;
    transition: opacity 0.25s ease;
    align-self: flex-start;
  }

  .perfumora-footer__wordmark:hover {
    opacity: 0.85;
  }

  .perfumora-footer__tagline,
  .perfumora-footer__tagline p {
    font-family: var(--font-body--family);
    font-size: 0.9375rem;
    line-height: 1.6;
    color: rgba(250, 248, 245, 0.5);
    margin: 0;
    max-width: 320px;
  }

  .perfumora-footer__nav {
    display: flex;
    flex-direction: column;
    gap: 16px;
    align-items: flex-start;
  }

  .perfumora-footer__link {
    font-family: var(--font-body--family);
    font-size: 0.9375rem;
    font-weight: 400;
    color: rgba(250, 248, 245, 0.65);
    text-decoration: none;
    transition: color 0.25s ease;
  }

  .perfumora-footer__link:hover {
    color: #faf8f5;
  }

  .perfumora-footer__bottom {
    display: flex;
    align-items: center;
    justify-content: space-between;
    border-top: 1px solid rgba(250, 248, 245, 0.1);
    padding-top: 28px;
    gap: 16px;
    flex-wrap: wrap;
  }

  .perfumora-footer__copyright,
  .perfumora-footer__subtext {
    font-family: var(--font-body--family);
    font-size: 0.75rem;
    font-weight: 500;
    letter-spacing: 0.14em;
    text-transform: uppercase;
    color: rgba(250, 248, 245, 0.45);
  }

  @media (max-width: 749px) {
    .perfumora-footer {
      min-height: auto;
      padding-block: 60px 32px;
    }

    .perfumora-footer__grid {
      grid-template-columns: 1fr;
      gap: 40px;
      margin-bottom: 48px;
    }

    .perfumora-footer__bottom {
      flex-direction: column;
      align-items: flex-start;
      gap: 10px;
    }
  }
{% endstylesheet %}

{% schema %}
{
  "name": "Footer",
  "tag": "section",
  "class": "section-footer",
  "enabled_on": {
    "groups": ["footer"]
  },
  "settings": [
    {
      "type": "text",
      "id": "brand_name",
      "label": "Brand Name",
      "default": "PERFUMORA"
    },
    {
      "type": "richtext",
      "id": "tagline",
      "label": "Tagline",
      "default": "<p>One sculpted vessel. Four expressions.<br>Endlessly refillable.</p>"
    },
    {
      "type": "link_list",
      "id": "menu",
      "label": "Menu"
    },
    {
      "type": "text",
      "id": "subtext",
      "label": "Bottom Subtext",
      "default": "SOUND CAN BE MUTED FROM THE HEADER"
    }
  ],
  "presets": [
    {
      "name": "Footer"
    }
  ]
}
{% endschema %}
