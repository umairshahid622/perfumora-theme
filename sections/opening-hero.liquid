{% comment %}
  Section contract: Opening Stage (Hero, Manifesto & Ritual)
  Renders the interactive Perfumora opening stage matching the haute-parfumerie reference:
  - Beat 1 (Hero): Oversized watermark, ambient radial glow, navigation arrows, slide counter, centered bottle
  - Beat 2 (Manifesto): Watermark/arrows fade out, Manifesto copy slides in flush-left, bottle drifts 34vw right
  - Beat 3 (Ritual): Manifesto fades, bottle glides back to center, Ritual header at top-left, 3 steps surround the bottle with hairline callout circuit lines and dots
  - Live across all beats: Persistent ambient glow and bottom product bar (subtitle, large price, size pills, Add to Bag)
  - Center slot reserved for the 3D bottle in Step 8
{% endcomment %}

<script
  type="module"
  src="{{ 'hero-stage.js' | asset_url }}"
  fetchpriority="high"
></script>

{% liquid
  assign fragrance_collection = section.settings.collection
  if fragrance_collection == blank or fragrance_collection.products_count == 0
    assign fragrance_collection = collections['fragrances']
  endif
  if fragrance_collection == blank or fragrance_collection.products_count == 0
    assign fragrance_collection = collections['all']
  endif

  # Filter fragrance products to prioritize Perfumora fragrances over any base theme demo products
  assign fragrance_handles_str = ''
  for p in fragrance_collection.products
    assign is_fragrance = false
    assign p_title_lower = p.title | downcase
    assign p_type_lower = p.type | downcase

    if p.metafields.perfumora.color_hex != blank or p.metafields.perfumora.fragrance_color_hex != blank or p.metafields.custom.fragrance_color_hex != blank or p.metafields.custom.color_hex != blank
      assign is_fragrance = true
    elsif p_title_lower contains 'boom shell' or p_title_lower contains 'parada' or p_title_lower contains 'perfume' or p_title_lower contains 'fragrance' or p_type_lower contains 'fragrance'
      assign is_fragrance = true
    elsif p_title_lower contains 'snowboard' or p_title_lower contains 'board' or p_type_lower contains 'snowboard'
      assign is_fragrance = false
    else
      for v in p.variants
        assign vt = v.title | downcase
        if vt contains '30' or vt contains '50' or vt contains 'ml'
          assign is_fragrance = true
          break
        endif
      endfor
    endif

    if is_fragrance
      if fragrance_handles_str == ''
        assign fragrance_handles_str = p.handle
      else
        assign fragrance_handles_str = fragrance_handles_str | append: ',' | append: p.handle
      endif
    endif
  endfor

  assign fragrance_handles = fragrance_handles_str | split: ','
  assign first_product = null
  if fragrance_handles.size > 0
    assign first_handle = fragrance_handles.first
    assign first_product = all_products[first_handle]
  endif

  if first_product == null or first_product.title == blank
    assign first_product = fragrance_collection.products.first
  endif

  assign raw_hex = first_product.metafields.perfumora.color_hex.value | default: first_product.metafields.perfumora.color_hex | default: first_product.metafields.perfumora.fragrance_color_hex.value | default: first_product.metafields.perfumora.fragrance_color_hex | default: first_product.metafields.custom.fragrance_color_hex.value | default: first_product.metafields.custom.fragrance_color_hex | default: first_product.metafields.custom.color_hex.value | default: first_product.metafields.custom.color_hex | default: '#b87d88'
  assign raw_hex_clean = raw_hex | downcase | strip

  case raw_hex_clean
    when '#e5aab2'
      assign initial_accent = '#9a7177'
    when '#b7bb81'
      assign initial_accent = '#7c7f56'
    when '#bb7528'
      assign initial_accent = '#ae6d25'
    when '#323b8f'
      assign initial_accent = '#323b8f'
    when '#e5e5e5'
      assign initial_accent = '#7c7c7c'
    else
      assign initial_accent = '#9a7177'
  endcase

  assign gender = first_product.metafields.perfumora.gender_category.value | default: first_product.metafields.perfumora.gender_category | default: first_product.metafields.custom.gender_category.value | default: first_product.metafields.custom.gender_category | default: 'Male'
  assign concentration = first_product.metafields.perfumora.concentration.value | default: first_product.metafields.perfumora.concentration | default: first_product.metafields.custom.concentration.value | default: first_product.metafields.custom.concentration | default: 'Extrait de Parfum'

  assign initial_variant = null
  for v in first_product.variants
    assign v_title = v.title | downcase
    if v_title contains '50' and v.available
      assign initial_variant = v
      break
    endif
  endfor

  if initial_variant == null
    assign initial_variant = first_product.selected_or_first_available_variant | default: first_product.variants.first
  endif

  assign total_count = fragrance_handles.size
  if total_count == 0
    assign total_count = 2
  endif
%}

<hero-stage
  class="hero-stage"
  data-total="{{ total_count }}"
  id="hero-stage"
  style="--hero-accent: {{ initial_accent }}; --hero-accent-glow: {{ initial_accent }}36;"
>
  <!-- In-page anchor targets for seamless navigation -->
  <div class="hero-stage__anchor" id="hero"></div>
  <div class="hero-stage__anchor hero-stage__anchor--manifesto" id="manifesto"></div>
  <div class="hero-stage__anchor hero-stage__anchor--ritual" id="ritual"></div>

  <script type="application/json" class="hero-stage__data">
    [
      {% if fragrance_handles.size > 0 %}
        {% for handle in fragrance_handles %}
          {% assign p = all_products[handle] %}
          {% if p and p.title != blank %}
            {% liquid
              assign p_hex = p.metafields.perfumora.color_hex.value | default: p.metafields.perfumora.color_hex | default: p.metafields.perfumora.fragrance_color_hex.value | default: p.metafields.perfumora.fragrance_color_hex | default: p.metafields.custom.fragrance_color_hex.value | default: p.metafields.custom.fragrance_color_hex | default: p.metafields.custom.color_hex.value | default: p.metafields.custom.color_hex
              if p_hex == blank
                assign p_t_lower = p.title | downcase
                if p_t_lower contains 'parada'
                  assign p_hex = '#7c7f56'
                else
                  assign p_hex = '#9a7177'
                endif
              endif

              assign p_gender = p.metafields.perfumora.gender_category.value | default: p.metafields.perfumora.gender_category | default: p.metafields.custom.gender_category.value | default: p.metafields.custom.gender_category | default: 'Male'
              assign p_conc = p.metafields.perfumora.concentration.value | default: p.metafields.perfumora.concentration | default: p.metafields.custom.concentration.value | default: p.metafields.custom.concentration | default: 'Extrait de Parfum'
            %}
            {
              "id": {{ p.id | json }},
              "title": {{ p.title | json }},
              "handle": {{ p.handle | json }},
              "url": {{ p.url | json }},
              "rawHex": {{ p_hex | json }},
              "gender": {{ p_gender | json }},
              "concentration": {{ p_conc | json }},
              "variants": [
                {% for v in p.variants %}
                  {
                    "id": {{ v.id | json }},
                    "title": {{ v.title | json }},
                    "price": {{ v.price | json }},
                    "formattedPrice": {{ v.price | money_without_trailing_zeros | replace: 'Rs.', 'Rs. ' | replace: 'Rs.  ', 'Rs. ' | json }},
                    "available": {{ v.available | json }}
                  }{% unless forloop.last %},{% endunless %}
                {% endfor %}
              ]
            }{% unless forloop.last %},{% endunless %}
          {% endif %}
        {% endfor %}
      {% else %}
        {
          "id": 1,
          "title": "Boom Shell",
          "handle": "boom-shell",
          "url": "/products/boom-shell",
          "rawHex": "#9a7177",
          "gender": "Male",
          "concentration": "Extrait de Parfum",
          "variants": [
            { "id": 101, "title": "30ML", "price": 360000, "formattedPrice": "Rs. 3,600", "available": true },
            { "id": 102, "title": "50ML", "price": 410000, "formattedPrice": "Rs. 4,100", "available": true }
          ]
        },
        {
          "id": 2,
          "title": "Parada",
          "handle": "parada",
          "url": "/products/parada",
          "rawHex": "#7c7f56",
          "gender": "Male",
          "concentration": "Eau de Cologne",
          "variants": [
            { "id": 201, "title": "30ML", "price": 360000, "formattedPrice": "Rs. 3,600", "available": true },
            { "id": 202, "title": "50ML", "price": 410000, "formattedPrice": "Rs. 4,100", "available": true }
          ]
        }
      {% endif %}
    ]
  </script>

  <!-- Persistent Sticky Viewport across Hero, Manifesto & Ritual beats -->
  <div class="hero-stage__sticky" ref="stickyViewport">
    <!-- Layer 1: Ambient Accent Radial Glow -->
    <div class="hero-stage__glow" aria-hidden="true"></div>

    <!-- Layer 2: Oversized Watermark Fragrance Name (Hero Beat) -->
    <div class="hero-stage__watermark-wrap" ref="watermarkWrap" aria-hidden="true">
      <span class="hero-stage__watermark" ref="watermark">
        {{ first_product.title | default: 'BOOM SHELL' }}
      </span>
    </div>

    <!-- Layer 3: Left / Right Carousel Navigation Arrows (Hero Beat) -->
    <button
      type="button"
      class="hero-stage__arrow hero-stage__arrow--prev"
      aria-label="Previous fragrance"
      ref="prevButton"
    >
      <svg width="22" height="22" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.6" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
        <path d="M19 12H5M12 19l-7-7 7-7"/>
      </svg>
    </button>
    <button
      type="button"
      class="hero-stage__arrow hero-stage__arrow--next"
      aria-label="Next fragrance"
      ref="nextButton"
    >
      <svg width="22" height="22" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.6" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
        <path d="M5 12h14M12 5l7 7-7 7"/>
      </svg>
    </button>

    <!-- Layer 4: Manifesto Beat Overlay (Left Column flush to page) -->
    <div class="hero-stage__manifesto-panel" ref="manifestoPanel" aria-hidden="true">
      <div class="hero-stage__manifesto-content">
        <span class="hero-stage__manifesto-eyebrow">
          {{ section.settings.manifesto_eyebrow | default: 'MANIFESTO' }}
        </span>
        <h2 class="hero-stage__manifesto-heading">
          {{ section.settings.manifesto_heading | default: 'MADE TO LAST.' }}
        </h2>
        <div class="hero-stage__manifesto-divider" aria-hidden="true"></div>
        <div class="hero-stage__manifesto-body">
          <p>{{ section.settings.manifesto_paragraph_1 | default: "A good fragrance is the easiest way to feel confident and put together. It's the final detail you put on before heading out, and the one people remember most." }}</p>
          <p>{{ section.settings.manifesto_paragraph_2 | default: "We focus on quality ingredients and long-lasting formulas made for everyday wear — simple, clean, and designed to stay with you from morning to night." }}</p>
        </div>
      </div>
    </div>

    <!-- Layer 5: Ritual Beat Overlay (Header top-left + 3 steps flanking center bottle) -->
    <div class="hero-stage__ritual-panel" ref="ritualPanel" aria-hidden="true">
      <!-- Top-left Header -->
      <div class="hero-stage__ritual-header">
        <span class="hero-stage__ritual-eyebrow">
          {{ section.settings.ritual_eyebrow | default: 'THE RITUAL' }}
        </span>
        <h2 class="hero-stage__ritual-heading">
          {{ section.settings.ritual_heading | default: 'THREE MOMENTS, ONE LASTING IMPRESSION' }}
        </h2>
        <p class="hero-stage__ritual-subtitle">
          {{ section.settings.ritual_subtitle | default: 'There are three moments, one lasting impression.' }}
        </p>
      </div>

      <!-- Desktop Steps Layout (Grid flanking center bottle) -->
      <div class="hero-stage__ritual-steps">
        <!-- 01 Prime — Left of bottle, line pointing right with dot -->
        <div class="hero-stage__ritual-step hero-stage__ritual-step--1">
          <div class="hero-stage__ritual-step-content">
            <div class="hero-stage__ritual-step-title-wrap">
              <span class="hero-stage__ritual-step-num">{{ section.settings.step_1_num | default: '01' }}</span>
              <h3 class="hero-stage__ritual-step-title">{{ section.settings.step_1_title | default: 'Prime' }}</h3>
            </div>
            <p class="hero-stage__ritual-step-body">
              {{ section.settings.step_1_body | default: 'A single press to warm pulse points — wrist, throat, the nape of the neck.' }}
            </p>
          </div>
          <div class="hero-stage__ritual-line-wrap hero-stage__ritual-line-wrap--1" aria-hidden="true">
            <svg viewBox="0 0 140 28" fill="none" class="hero-stage__ritual-svg">
              <path d="M 0 6 L 65 6 L 98 22 L 132 22" stroke="currentColor" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round" />
              <circle cx="132" cy="22" r="3.5" fill="currentColor" />
            </svg>
          </div>
        </div>

        <!-- 02 Apply — Upper right of bottle, line pointing from near bottle to Apply -->
        <div class="hero-stage__ritual-step hero-stage__ritual-step--2">
          <div class="hero-stage__ritual-line-wrap hero-stage__ritual-line-wrap--2" aria-hidden="true">
            <svg viewBox="0 0 140 28" fill="none" class="hero-stage__ritual-svg">
              <circle cx="8" cy="22" r="3.5" fill="currentColor" />
              <path d="M 8 22 L 42 22 L 75 6 L 140 6" stroke="currentColor" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round" />
            </svg>
          </div>
          <div class="hero-stage__ritual-step-content">
            <div class="hero-stage__ritual-step-title-wrap">
              <span class="hero-stage__ritual-step-num">{{ section.settings.step_2_num | default: '02' }}</span>
              <h3 class="hero-stage__ritual-step-title">{{ section.settings.step_2_title | default: 'Apply' }}</h3>
            </div>
            <p class="hero-stage__ritual-step-body">
              {{ section.settings.step_2_body | default: "Hold the vessel a hand's width away and let the mist settle, never rub." }}
            </p>
          </div>
        </div>

        <!-- 03 Layer — Lower right of bottle, horizontal line with dot -->
        <div class="hero-stage__ritual-step hero-stage__ritual-step--3">
          <div class="hero-stage__ritual-line-wrap hero-stage__ritual-line-wrap--3" aria-hidden="true">
            <svg viewBox="0 0 140 20" fill="none" class="hero-stage__ritual-svg">
              <circle cx="8" cy="10" r="3.5" fill="currentColor" />
              <path d="M 8 10 L 50 10 L 95 10 L 140 10" stroke="currentColor" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round" />
            </svg>
          </div>
          <div class="hero-stage__ritual-step-content">
            <div class="hero-stage__ritual-step-title-wrap">
              <span class="hero-stage__ritual-step-num">{{ section.settings.step_3_num | default: '03' }}</span>
              <h3 class="hero-stage__ritual-step-title">{{ section.settings.step_3_title | default: 'Layer' }}</h3>
            </div>
            <p class="hero-stage__ritual-step-body">
              {{ section.settings.step_3_body | default: 'Return through the day as the scent softens; the refill is always close.' }}
            </p>
          </div>
        </div>
      </div>
    </div>

    <!-- Layer 6: Center / Drifting Stage: Bottle Mount & Position Counter -->
    <div class="hero-stage__center">
      <div class="hero-stage__bottle-mount-wrap" ref="bottleMountWrap">
        <div class="hero-stage__bottle-mount" id="hero-bottle-mount">
          <!-- 3D bottle mounted here in Step 8 -->
        </div>
      </div>

      <!-- Slide Position Counter (Hero Beat) -->
      <div class="hero-stage__counter" ref="counter">
        <span class="hero-stage__counter-current" ref="counterCurrent">01</span>
        <span class="hero-stage__counter-sep">/</span>
        <span class="hero-stage__counter-total" ref="counterTotal">
          {% if total_count < 10 %}0{% endif %}{{ total_count }}
        </span>
      </div>
    </div>

    <!-- Layer 7: Persistent Bottom Product Bar (Live across all beats) -->
    <div class="hero-stage__product-bar" ref="productBar">
      <!-- Left: Subtitle & Large Price -->
      <div class="hero-stage__info">
        <div class="hero-stage__subtitle" ref="subtitle">
          {{ first_product.title | default: 'BOOM SHELL' | upcase }} · {{ gender | upcase }} · {{ concentration | upcase }}
        </div>
        <div class="hero-stage__price" ref="price">
          {{ initial_variant.price | default: 410000 | money_without_trailing_zeros | replace: 'Rs.', 'Rs. ' | replace: 'Rs.  ', 'Rs. ' }}
        </div>
      </div>

      <!-- Center: Size Selector Pills -->
      <div class="hero-stage__sizes" ref="sizes" role="radiogroup" aria-label="Select size">
        {% if first_product.variants.size > 0 %}
          {% for v in first_product.variants %}
            {% assign is_active = false %}
            {% if v.id == initial_variant.id %}
              {% assign is_active = true %}
            {% endif %}
            <button
              type="button"
              role="radio"
              class="hero-stage__size-btn{% if is_active %} is-active{% endif %}"
              aria-checked="{% if is_active %}true{% else %}false{% endif %}"
              data-variant-id="{{ v.id }}"
              {% unless v.available %}disabled{% endunless %}
            >
              {{ v.title | upcase }}
            </button>
          {% endfor %}
        {% else %}
          <button type="button" role="radio" class="hero-stage__size-btn" aria-checked="false">30ML</button>
          <button type="button" role="radio" class="hero-stage__size-btn is-active" aria-checked="true">50ML</button>
        {% endif %}
      </div>

      <!-- Right: Add to Bag Button -->
      <div class="hero-stage__actions">
        <button
          type="button"
          class="hero-stage__add-btn"
          ref="addButton"
          data-variant-id="{{ initial_variant.id | default: 102 }}"
          {% if initial_variant and initial_variant.available == false %}disabled{% endif %}
        >
          {% if initial_variant == null or initial_variant.available %}
            Add to Bag
          {% else %}
            Sold Out
          {% endif %}
        </button>
      </div>
    </div>
  </div>
</hero-stage>

{% stylesheet %}
  hero-stage,
  .hero-stage {
    display: block;
    position: relative;
    width: 100%;
    height: 320vh; /* Scrollytelling track: Hero (0-100vh) -> Manifesto (100-200vh) -> Ritual (200-320vh) */
    background-color: var(--color-background, #c9c2b8);
    box-sizing: border-box;
  }

  .hero-stage__anchor {
    position: absolute;
    top: 0;
    width: 1px;
    height: 1px;
    pointer-events: none;
    opacity: 0;
  }

  .hero-stage__anchor--manifesto {
    top: 75vh;
  }

  .hero-stage__anchor--ritual {
    top: 175vh;
  }

  .hero-stage__sticky {
    position: sticky;
    top: var(--header-height, 0px);
    width: 100%;
    height: calc(100vh - var(--header-height, 0px));
    min-height: 600px;
    display: flex;
    flex-direction: column;
    justify-content: space-between;
    overflow: hidden;
    box-sizing: border-box;
  }

  @media (max-width: 749px) {
    hero-stage,
    .hero-stage {
      height: 260vh;
    }
    .hero-stage__sticky {
      min-height: 540px;
    }
  }

  .hero-stage__glow {
    position: absolute;
    inset: 0;
    pointer-events: none;
    background: radial-gradient(55% 45% at 50% 50%, var(--hero-accent-glow, rgba(154, 113, 119, 0.22)), transparent 72%);
    transition: background 0.6s cubic-bezier(0.16, 1, 0.3, 1);
    z-index: 1;
  }

  .hero-stage__watermark-wrap {
    position: absolute;
    inset: 0;
    display: flex;
    align-items: center;
    justify-content: center;
    pointer-events: none;
    user-select: none;
    z-index: 1;
    overflow: hidden;
    padding-inline: 24px;
    will-change: opacity, transform;
    transition: opacity 0.2s ease-out;
  }

  .hero-stage__watermark {
    font-family: var(--font-heading--family);
    font-size: clamp(4.5rem, 15vw, 13.5rem);
    font-weight: 600;
    text-transform: uppercase;
    letter-spacing: 0.04em;
    color: rgba(26, 24, 22, 0.075);
    white-space: nowrap;
    line-height: 0.9;
    transition: opacity 0.35s ease, transform 0.35s ease;
  }

  .hero-stage__arrow {
    position: absolute;
    top: 50%;
    transform: translateY(-50%);
    z-index: 10;
    width: 50px;
    height: 50px;
    border-radius: 50%;
    border: 1px solid rgba(26, 24, 22, 0.16);
    background: rgba(201, 194, 184, 0.4);
    backdrop-filter: blur(8px);
    -webkit-backdrop-filter: blur(8px);
    color: #1a1816;
    display: flex;
    align-items: center;
    justify-content: center;
    cursor: pointer;
    transition: all 0.25s cubic-bezier(0.16, 1, 0.3, 1);
    will-change: opacity, transform;
  }

  .hero-stage__arrow:hover {
    border-color: var(--hero-accent, #9a7177);
    color: var(--hero-accent, #9a7177);
    transform: translateY(-50%) scale(1.06);
    background: rgba(201, 194, 184, 0.7);
  }

  .hero-stage__arrow--prev {
    left: 48px;
  }

  .hero-stage__arrow--next {
    right: 48px;
  }

  @media (max-width: 749px) {
    .hero-stage__arrow {
      width: 42px;
      height: 42px;
    }
    .hero-stage__arrow--prev {
      left: 16px;
    }
    .hero-stage__arrow--next {
      right: 16px;
    }
  }

  /* Manifesto Beat Overlay */
  .hero-stage__manifesto-panel {
    position: absolute;
    inset-inline: 0;
    top: 0;
    bottom: 90px;
    display: flex;
    align-items: center;
    max-width: var(--page-width, 1340px);
    margin-inline: auto;
    padding-inline: 48px;
    pointer-events: none;
    z-index: 6;
    opacity: 0;
    transform: translateX(-50px);
    will-change: opacity, transform;
    transition: opacity 0.2s ease-out;
  }

  .hero-stage__manifesto-content {
    max-width: min(460px, 38vw);
    display: flex;
    flex-direction: column;
  }

  .hero-stage__manifesto-eyebrow {
    font-size: 0.75rem;
    font-weight: 500;
    letter-spacing: 0.14em;
    text-transform: uppercase;
    color: rgba(26, 24, 22, 0.6);
    margin-bottom: 16px;
  }

  .hero-stage__manifesto-heading {
    font-family: var(--font-heading--family);
    font-size: clamp(2.5rem, 5.5vw, 4.25rem);
    font-weight: 600;
    line-height: 1.02;
    letter-spacing: 0.02em;
    text-transform: uppercase;
    color: var(--color-foreground, #1a1816);
    margin: 0;
  }

  .hero-stage__manifesto-divider {
    width: 100%;
    height: 1px;
    background-color: rgba(26, 24, 22, 0.15);
    margin-block: 24px 24px;
  }

  .hero-stage__manifesto-body {
    display: flex;
    flex-direction: column;
    gap: 16px;
  }

  .hero-stage__manifesto-body p {
    font-size: 1.05rem;
    line-height: 1.7;
    color: rgba(26, 24, 22, 0.78);
    margin: 0;
  }

  /* Ritual Beat Overlay */
  .hero-stage__ritual-panel {
    position: absolute;
    inset-inline: 0;
    top: 0;
    bottom: 90px;
    display: flex;
    flex-direction: column;
    justify-content: space-between;
    max-width: var(--page-width, 1340px);
    margin-inline: auto;
    padding-inline: 48px;
    padding-top: 18px;
    pointer-events: none;
    z-index: 6;
    opacity: 0;
    transform: translateY(20px);
    will-change: opacity, transform;
    transition: opacity 0.2s ease-out;
  }

  .hero-stage__ritual-header {
    display: flex;
    flex-direction: column;
    max-width: 480px;
  }

  .hero-stage__ritual-eyebrow {
    font-size: 0.75rem;
    font-weight: 500;
    letter-spacing: 0.14em;
    text-transform: uppercase;
    color: rgba(26, 24, 22, 0.6);
    margin-bottom: 6px;
  }

  .hero-stage__ritual-heading {
    font-family: var(--font-heading--family);
    font-size: clamp(1.85rem, 3.8vw, 3rem);
    font-weight: 600;
    line-height: 1.05;
    letter-spacing: 0.01em;
    text-transform: uppercase;
    color: var(--color-foreground, #1a1816);
    margin: 0;
    max-width: 18ch;
  }

  .hero-stage__ritual-subtitle {
    font-size: 0.8125rem;
    color: rgba(26, 24, 22, 0.65);
    margin-top: 6px;
    margin-bottom: 0;
  }

  .hero-stage__ritual-steps {
    position: absolute;
    inset-inline: 48px;
    top: 48%;
    transform: translateY(-50%);
    display: grid;
    grid-template-columns: 1fr minmax(280px, 360px) 1fr;
    grid-template-rows: auto auto;
    align-items: center;
    column-gap: 16px;
    row-gap: 32px;
    pointer-events: none;
  }

  .hero-stage__ritual-step--1 {
    grid-column: 1;
    grid-row: 1 / span 2;
    display: flex;
    align-items: center;
    justify-content: flex-end;
    text-align: left;
  }

  .hero-stage__ritual-step--2 {
    grid-column: 3;
    grid-row: 1;
    display: flex;
    align-items: center;
    justify-content: flex-start;
    text-align: left;
  }

  .hero-stage__ritual-step--3 {
    grid-column: 3;
    grid-row: 2;
    display: flex;
    align-items: center;
    justify-content: flex-start;
    text-align: left;
  }

  .hero-stage__ritual-step-content {
    max-width: 260px;
    pointer-events: auto;
  }

  .hero-stage__ritual-step-title-wrap {
    display: flex;
    align-items: baseline;
    gap: 8px;
  }

  .hero-stage__ritual-step-num {
    font-family: var(--font-heading--family);
    font-size: 1.625rem;
    font-weight: 500;
    line-height: 1;
    color: var(--hero-accent, #9a7177);
  }

  .hero-stage__ritual-step-title {
    font-family: var(--font-body--family);
    font-size: 1.0625rem;
    font-weight: 600;
    color: #1a1816;
    margin: 0;
  }

  .hero-stage__ritual-step-body {
    font-size: 0.8125rem;
    line-height: 1.6;
    color: rgba(26, 24, 22, 0.72);
    margin-top: 4px;
    margin-bottom: 0;
  }

  .hero-stage__ritual-line-wrap {
    width: clamp(70px, 7.5vw, 120px);
    flex-shrink: 0;
    color: var(--hero-accent, #9a7177);
    stroke: var(--hero-accent, #9a7177);
  }

  .hero-stage__ritual-line-wrap--1 {
    margin-left: 12px;
  }

  .hero-stage__ritual-line-wrap--2,
  .hero-stage__ritual-line-wrap--3 {
    margin-right: 12px;
  }

  .hero-stage__ritual-svg {
    width: 100%;
    height: auto;
    overflow: visible;
  }

  @media (max-width: 890px) {
    .hero-stage__manifesto-panel,
    .hero-stage__ritual-panel {
      padding-inline: 20px;
      bottom: 120px;
    }
    .hero-stage__ritual-steps {
      position: static;
      transform: none;
      display: flex;
      flex-direction: column;
      gap: 14px;
      margin-top: auto;
      margin-bottom: 8px;
    }
    .hero-stage__ritual-step--1,
    .hero-stage__ritual-step--2,
    .hero-stage__ritual-step--3 {
      justify-content: flex-start;
    }
    .hero-stage__ritual-line-wrap {
      display: none;
    }
    .hero-stage__ritual-step-content {
      max-width: 100%;
    }
  }

  .hero-stage__center {
    position: relative;
    z-index: 3;
    display: flex;
    flex-direction: column;
    align-items: center;
    justify-content: center;
    flex-grow: 1;
    padding-top: 16px;
    pointer-events: none;
  }

  .hero-stage__bottle-mount-wrap {
    position: relative;
    display: flex;
    align-items: center;
    justify-content: center;
    will-change: transform;
    transition: transform 0.15s ease-out;
    pointer-events: auto;
  }

  .hero-stage__bottle-mount {
    min-height: 380px;
    width: 100%;
    max-width: 420px;
    display: flex;
    align-items: center;
    justify-content: center;
    position: relative;
  }

  @media (max-width: 749px) {
    .hero-stage__bottle-mount {
      min-height: 260px;
    }
  }

  .hero-stage__counter {
    display: flex;
    align-items: baseline;
    justify-content: center;
    gap: 4px;
    font-variant-numeric: tabular-nums;
    user-select: none;
    margin-top: 10px;
    z-index: 5;
    will-change: opacity;
    transition: opacity 0.2s ease-out;
  }

  .hero-stage__counter-current {
    font-family: var(--font-heading--family);
    font-size: 2.5rem;
    font-weight: 500;
    color: var(--hero-accent, #9a7177);
    line-height: 1;
    transition: color 0.4s ease;
  }

  .hero-stage__counter-sep {
    font-size: 0.95rem;
    color: rgba(26, 24, 22, 0.4);
    margin-inline: 3px;
  }

  .hero-stage__counter-total {
    font-family: var(--font-body--family);
    font-size: 0.85rem;
    font-weight: 500;
    color: rgba(26, 24, 22, 0.55);
    letter-spacing: 0.05em;
  }

  .hero-stage__product-bar {
    position: relative;
    z-index: 10;
    width: 100%;
    max-width: var(--page-width, 1340px);
    margin-inline: auto;
    padding: 16px 48px 36px;
    display: grid;
    grid-template-columns: 1fr auto 1fr;
    align-items: flex-end;
    gap: 24px;
    box-sizing: border-box;
    pointer-events: auto;
  }

  @media (max-width: 890px) {
    .hero-stage__product-bar {
      grid-template-columns: 1fr;
      gap: 16px;
      padding: 14px 20px 24px;
    }
    .hero-stage__actions {
      justify-content: stretch;
    }
    .hero-stage__add-btn {
      width: 100%;
    }
  }

  .hero-stage__info {
    min-width: 0;
  }

  .hero-stage__subtitle {
    font-size: 0.75rem;
    font-weight: 500;
    letter-spacing: 0.12em;
    text-transform: uppercase;
    color: rgba(26, 24, 22, 0.65);
    margin-bottom: 3px;
    white-space: nowrap;
    overflow: hidden;
    text-overflow: ellipsis;
  }

  .hero-stage__price {
    font-family: var(--font-heading--family);
    font-size: clamp(2.5rem, 4.2vw, 3.6rem);
    font-weight: 600;
    line-height: 1;
    color: var(--hero-accent, #9a7177);
    transition: color 0.4s ease;
    letter-spacing: -0.01em;
  }

  .hero-stage__sizes {
    display: flex;
    align-items: center;
    justify-content: center;
    gap: 10px;
  }

  .hero-stage__size-btn {
    border-radius: 9999px;
    padding: 9px 24px;
    font-size: 0.75rem;
    font-weight: 500;
    text-transform: uppercase;
    letter-spacing: 0.06em;
    background: transparent;
    cursor: pointer;
    border: 1px solid rgba(26, 24, 22, 0.22);
    color: rgba(26, 24, 22, 0.65);
    transition: all 0.2s ease;
  }

  .hero-stage__size-btn:hover:not(:disabled) {
    color: #1a1816;
    border-color: rgba(26, 24, 22, 0.45);
  }

  .hero-stage__size-btn.is-active {
    border: 1.5px solid var(--hero-accent, #9a7177);
    color: var(--hero-accent, #9a7177);
    font-weight: 600;
  }

  .hero-stage__size-btn:disabled {
    text-decoration: line-through;
    opacity: 0.4;
    cursor: not-allowed;
  }

  .hero-stage__actions {
    display: flex;
    justify-content: flex-end;
  }

  .hero-stage__add-btn {
    border-radius: 9999px;
    background-color: var(--hero-accent, #9a7177);
    color: #ffffff;
    padding: 15px 44px;
    font-family: var(--font-body--family);
    font-size: 0.78rem;
    font-weight: 600;
    letter-spacing: 0.12em;
    text-transform: uppercase;
    border: none;
    cursor: pointer;
    box-shadow: 0 4px 16px rgba(11, 11, 12, 0.18);
    transition: all 0.25s cubic-bezier(0.16, 1, 0.3, 1);
  }

  .hero-stage__add-btn:hover:not(:disabled) {
    opacity: 0.92;
    transform: translateY(-1px);
    box-shadow: 0 6px 20px rgba(11, 11, 12, 0.26);
  }

  .hero-stage__add-btn:active:not(:disabled) {
    transform: translateY(0);
  }

  .hero-stage__add-btn:disabled {
    opacity: 0.45;
    cursor: not-allowed;
  }

  .hero-stage__add-btn.is-loading {
    opacity: 0.75;
    pointer-events: none;
  }
{% endstylesheet %}

