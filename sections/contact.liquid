{% comment %}
  Section contract: Contact
  Renders the atelier appointment intro beside the client inquiry form.
  @example
  <!-- In templates/index.json: "type": "contact" -->
{% endcomment %}

<div class="contact-section section section--page-width" id="contact" data-tone="light">
  <div class="contact-grid">
    <div class="contact-intro">
      {% if section.settings.eyebrow != blank %}
        <span class="contact-eyebrow">{{ section.settings.eyebrow }}</span>
      {% endif %}

      {% if section.settings.heading != blank %}
        <h2 class="contact-heading">{{ section.settings.heading }}</h2>
      {% endif %}

      {% if section.settings.body != blank %}
        <p class="contact-body">{{ section.settings.body }}</p>
      {% endif %}

      <div class="contact-details">
        {% if section.settings.email != blank %}
          <a href="mailto:{{ section.settings.email }}" class="contact-email">{{ section.settings.email }}</a>
        {% endif %}
        {% if section.settings.location != blank %}
          <span class="contact-location">{{ section.settings.location }}</span>
        {% endif %}
      </div>
    </div>

    <div class="contact-form-wrapper">
      {% form 'contact', class: 'perfumora-contact-form' %}
        {% if form.posted_successfully? %}
          <div class="contact-success" role="status">
            Thank you for reaching out. The atelier will respond in kind.
          </div>
        {% endif %}

        {% if form.errors %}
          <div class="contact-error" role="alert">
            {{ form.errors | default_errors }}
          </div>
        {% endif %}

        <div class="contact-field">
          <label for="ContactFormName-{{ section.id }}" class="visually-hidden">Name</label>
          <input
            type="text"
            id="ContactFormName-{{ section.id }}"
            name="contact[name]"
            class="contact-input"
            value="{% if form.name %}{{ form.name }}{% elsif customer %}{{ customer.name }}{% endif %}"
            placeholder="Name"
            required
            autocomplete="name"
          >
        </div>

        <div class="contact-field">
          <label for="ContactFormEmail-{{ section.id }}" class="visually-hidden">Email</label>
          <input
            type="email"
            id="ContactFormEmail-{{ section.id }}"
            name="contact[email]"
            class="contact-input"
            value="{% if form.email %}{{ form.email }}{% elsif customer %}{{ customer.email }}{% endif %}"
            placeholder="Email"
            required
            autocomplete="email"
          >
        </div>

        <div class="contact-field">
          <label for="ContactFormMessage-{{ section.id }}" class="visually-hidden">Message</label>
          <textarea
            rows="5"
            id="ContactFormMessage-{{ section.id }}"
            name="contact[body]"
            class="contact-textarea"
            placeholder="Message"
            required
          >{% if form.body %}{{ form.body }}{% endif %}</textarea>
        </div>

        <button type="submit" class="contact-submit-btn" aria-label="Send message">
          Send message
        </button>
      {% endform %}
    </div>
  </div>
</div>

{% stylesheet %}
  .contact-section {
    padding-block: clamp(80px, 12vh, 130px);
    background: transparent;
  }

  .contact-grid {
    display: grid;
    grid-template-columns: 1.05fr 1fr;
    gap: clamp(40px, 6vw, 90px);
    align-items: start;
    max-width: 1100px;
    margin-inline: auto;
  }

  .contact-intro {
    display: flex;
    flex-direction: column;
  }

  .contact-eyebrow {
    display: block;
    font-family: var(--font-body--family);
    font-size: 0.75rem;
    font-weight: 500;
    letter-spacing: 0.16em;
    text-transform: uppercase;
    color: rgba(26, 24, 22, 0.6);
    margin-bottom: 18px;
  }

  .contact-heading {
    font-family: var(--font-heading--family);
    font-size: clamp(3rem, 5.5vw, 4.75rem);
    font-weight: 700;
    line-height: 0.95;
    letter-spacing: -0.01em;
    text-transform: uppercase;
    color: #0b0b0c;
    margin: 0 0 24px;
    max-width: 12ch;
    text-wrap: balance;
  }

  .contact-body {
    font-family: var(--font-body--family);
    font-size: 0.95rem;
    line-height: 1.65;
    color: rgba(26, 24, 22, 0.72);
    margin: 0 0 36px;
    max-width: 380px;
  }

  .contact-details {
    display: flex;
    flex-direction: column;
    gap: 4px;
    font-family: var(--font-body--family);
    font-size: 0.9rem;
  }

  .contact-email {
    color: #0b0b0c;
    text-decoration: none;
    font-weight: 500;
    transition: opacity 0.2s ease;
  }

  .contact-email:hover {
    opacity: 0.75;
  }

  .contact-location {
    color: rgba(26, 24, 22, 0.6);
  }

  .perfumora-contact-form {
    display: flex;
    flex-direction: column;
    gap: 16px;
    background: transparent;
    border: none;
    box-shadow: none;
    padding: 0;
  }

  .contact-field {
    width: 100%;
  }

  .contact-input,
  .contact-textarea {
    width: 100%;
    box-sizing: border-box;
    border-radius: 14px;
    border: 1px solid rgba(26, 24, 22, 0.14);
    background-color: rgba(26, 24, 22, 0.04);
    color: #0b0b0c;
    padding: 16px 20px;
    font-family: var(--font-body--family);
    font-size: 0.9375rem;
    outline: none;
    transition: border-color 0.2s ease, background-color 0.2s ease, box-shadow 0.2s ease;
  }

  .contact-input::placeholder,
  .contact-textarea::placeholder {
    color: rgba(26, 24, 22, 0.45);
  }

  .contact-input:focus,
  .contact-textarea:focus {
    border-color: rgba(26, 24, 22, 0.45);
    background-color: rgba(26, 24, 22, 0.06);
    box-shadow: 0 0 0 3px rgba(26, 24, 22, 0.04);
  }

  .contact-textarea {
    resize: vertical;
    min-height: 150px;
    line-height: 1.5;
  }

  .contact-submit-btn {
    align-self: flex-start;
    border-radius: 9999px;
    border: none;
    background-color: #9a7177;
    color: #ffffff;
    padding: 15px 36px;
    font-family: var(--font-body--family);
    font-size: 0.75rem;
    font-weight: 600;
    letter-spacing: 0.12em;
    text-transform: uppercase;
    cursor: pointer;
    margin-top: 6px;
    box-shadow: 0 8px 24px -8px rgba(154, 113, 119, 0.45);
    transition: all 0.25s cubic-bezier(0.16, 1, 0.3, 1);
  }

  .contact-submit-btn:hover {
    opacity: 0.94;
    transform: translateY(-2px);
    box-shadow: 0 12px 28px -6px rgba(154, 113, 119, 0.55);
  }

  .contact-success {
    padding: 14px 20px;
    border-radius: 12px;
    background-color: rgba(79, 121, 66, 0.15);
    color: #2e5326;
    font-size: 0.875rem;
  }

  .contact-error {
    padding: 14px 20px;
    border-radius: 12px;
    background-color: rgba(187, 40, 40, 0.12);
    color: #8c1d1d;
    font-size: 0.875rem;
  }

  @media (max-width: 860px) {
    .contact-grid {
      grid-template-columns: 1fr;
      gap: 48px;
    }

    .contact-heading {
      font-size: clamp(2.5rem, 9vw, 3.5rem);
    }
  }
{% endstylesheet %}

{% schema %}
{
  "name": "Contact Atelier",
  "tag": "section",
  "class": "section-contact",
  "settings": [
    {
      "type": "text",
      "id": "eyebrow",
      "label": "Eyebrow",
      "default": "Contact"
    },
    {
      "type": "text",
      "id": "heading",
      "label": "Heading",
      "default": "Speak with the atelier"
    },
    {
      "type": "textarea",
      "id": "body",
      "label": "Body",
      "default": "Questions on layering, refills, or a bespoke commission — leave a note and we'll respond in kind."
    },
    {
      "type": "text",
      "id": "email",
      "label": "Email",
      "default": "hello@perfumora.example"
    },
    {
      "type": "text",
      "id": "location",
      "label": "Location",
      "default": "By appointment · Pakistan"
    }
  ],
  "presets": [
    {
      "name": "Contact Atelier"
    }
  ]
}
{% endschema %}
